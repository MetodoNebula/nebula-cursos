      "items": [
        {
          "id": "CP-U01-01",
          "stem": "Find the highest common factor (HCF) of $36$ and $90$.",
          "options": ["$6$", "$9$", "$18$", "$36$"],
          "correct": 2,
          "explanation": "$36 = 2^2 \\times 3^2$ and $90 = 2 \\times 3^2 \\times 5$. The HCF takes the lowest power of each shared prime: $2^1 \\times 3^2 = 18$.",
          "mapped_lesson": "GCSEMATHS::U01_Number::types_of_number_factors_and_multiples"
        },
        {
          "id": "CP-U01-02",
          "stem": "Write $0.00345$ in standard form.",
          "options": ["$3.45 \\times 10^{-2}$", "$3.45 \\times 10^{-3}$", "$34.5 \\times 10^{-4}$", "$0.345 \\times 10^{-2}$"],
          "correct": 1,
          "explanation": "Move the decimal point 3 places to the right to get $3.45$, so the power of 10 is $-3$: $3.45 \\times 10^{-3}$.",
          "mapped_lesson": "GCSEMATHS::U01_Number::standard_form"
        },
        {
          "id": "CP-U01-03",
          "stem": "Write $\\tfrac{7}{20}$ as a percentage.",
          "options": ["$7\\%$", "$20\\%$", "$35\\%$", "$70\\%$"],
          "correct": 2,
          "explanation": "$\\tfrac{7}{20} = \\tfrac{7 \\times 5}{20 \\times 5} = \\tfrac{35}{100} = 35\\%$.",
          "mapped_lesson": "GCSEMATHS::U01_Number::fractions_decimals_and_percentages"
        },
        {
          "id": "CP-U01-04",
          "stem": "Divide $\\$480$ in the ratio $3:5$.",
          "options": ["$\\$120$ and $\\$360$", "$\\$160$ and $\\$320$", "$\\$180$ and $\\$300$", "$\\$240$ and $\\$240$"],
          "correct": 2,
          "explanation": "Total parts $= 3 + 5 = 8$. One part $= 480 \\div 8 = 60$. So the shares are $3 \\times 60 = \\$180$ and $5 \\times 60 = \\$300$.",
          "mapped_lesson": "GCSEMATHS::U01_Number::ratio_and_proportion"
        },
        {
          "id": "CP-U01-05",
          "stem": "A shirt costs $\\$40$. It is reduced by $15\\%$ in a sale. What is the sale price?",
          "options": ["$\\$6$", "$\\$25$", "$\\$34$", "$\\$46$"],
          "correct": 2,
          "explanation": "$15\\%$ of $\\$40 = 0.15 \\times 40 = \\$6$. Sale price $= 40 - 6 = \\$34$.",
          "mapped_lesson": "GCSEMATHS::U01_Number::percentages"
        }
      ]
    },
